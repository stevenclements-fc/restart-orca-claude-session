{
  "title": "Restart Claude Code sessions",
  "rules": [
    {
      "description": "Hyper+R: restart Claude Code sessions (asks first)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "r",
            "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
          },
          "to": [{ "shell_command": "\"$HOME/bin/restart-claude-sessions.zsh\" --gui" }]
        }
      ]
    }
  ]
}
